# Local tools and credentials
.idea/
.vscode/
.env
.env.*
!.env.example
local.properties
*.jks
*.keystore

# JavaScript / Expo / Android build output
node_modules/
.expo/
.gradle/
.kotlin/
**/build/
dist/
*.apk
*.aab
*.log

# Large local assets and personal recordings
/models/
/recordings/
/app/models/
/app/recordings/
/app/android/app/src/main/assets/models/

# Generated offline model bundle (real weights are never committed)
/app/modules/audio-engine/android/src/main/assets/models/

# Reproducible development-only UI gallery build
/artifacts/ui-preview/

# Python helper caches
__pycache__/
*.pyc

# Release staging copies (canonical test audio is tracked under artifacts/test-audio)
/artifacts/releases/*/*.wav

# Short Windows CMake staging directory
/.cxx/

# Test datasets downloaded for DER verification
/artifacts/test-datasets/

# Local detailed ML debug output; publish only aggregate results/metrics.
/artifacts/test-results/hour-ami-2026-11-08/oom-fix*/**/*.png
/artifacts/test-results/hour-ami-2026-11-08/oom-fix*/**/*.xml
/artifacts/test-results/hour-ami-2026-11-08/oom-fix*/**/status.json
/artifacts/test-results/hour-ami-2026-11-08/oom-fix-full/transcript.json
/artifacts/test-results/hour-ami-2026-11-08/oom-fix-full/reopened-transcript.json
/artifacts/test-results/oom-fix-2026-11-08/**/*.png
/artifacts/test-results/oom-fix-2026-11-08/**/[0-9]*.json
/artifacts/test-results/oom-fix-2026-11-08/**/short-transcript.json

# Submission binaries are attached to GitHub Release. Remotion inputs remain source assets.
/artifacts/submission/*.mp4
/artifacts/submission/*.zip
/artifacts/submission/submission-SHA256SUMS.txt

/artifacts/submission/demo-real-SHA256SUMS.txt
