{
  "expo": {
    "name": "Нейро-стенографист",
    "slug": "nuclear-stenographer",
    "version": "1.2.3",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "team.hex.nuclearstenographer",
      "largeHeap": true,
      "versionCode": 12
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sharing",
      "./plugins/withBundledModels.cjs",
      [
        "llama.rn",
        {
          "enableOpenCLAndHexagon": false,
          "enableEntitlements": false
        }
      ],
      "./plugins/withShortNativePaths.cjs",
      "expo-image",
      "expo-font",
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": "Разрешите запись разговоров через микрофон.",
          "enableBackgroundRecording": false
        }
      ]
    ],
    "scheme": "stenographer"
  }
}
